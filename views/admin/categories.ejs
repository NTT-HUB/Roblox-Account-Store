<%- include('../partials/header', { title: 'Quản lý danh mục' }) %>
<div class="admin-layout">
  <%- include('_sidebar') %>
  <div class="admin-content">
    <h2>Danh mục</h2>
    <div class="admin-grid-2">
      <div>
        <table class="table">
          <thead><tr><th>ID</th><th>Tên</th><th>Slug</th><th>Số acc</th><th></th></tr></thead>
          <tbody>
            <% categories.forEach(function(c) { %>
              <tr>
                <td><%= c.id %></td>
                <td>
                  <form method="post" action="/admin/categories/<%= c.id %>/update" class="inline-edit">
                    <input type="text" name="name" value="<%= c.name %>" required />
                    <input type="text" name="description" value="<%= c.description || '' %>" placeholder="Mô tả" />
                    <input type="number" name="sort_order" value="<%= c.sort_order %>" style="width:70px" />
                    <button class="btn btn-sm" type="submit">Lưu</button>
                  </form>
                </td>
                <td class="muted small"><%= c.slug %></td>
                <td><%= c.product_count %></td>
                <td>
                  <% if (c.product_count === 0) { %>
                    <form method="post" action="/admin/categories/<%= c.id %>/delete" onsubmit="return confirm('Xoá danh mục?')" style="display:inline">
                      <button class="btn btn-danger btn-sm" type="submit">Xoá</button>
                    </form>
                  <% } else { %><span class="muted small">—</span><% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div>
        <h3>Thêm danh mục</h3>
        <form method="post" action="/admin/categories" class="form">
          <label>Tên danh mục<input type="text" name="name" required /></label>
          <label>Mô tả<textarea name="description" rows="3"></textarea></label>
          <label>Thứ tự hiển thị<input type="number" name="sort_order" value="0" /></label>
          <button class="btn btn-primary" type="submit">Thêm</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
