<%- include('../partials/header', { title: 'Quản lý Acc' }) %>
<div class="admin-layout">
  <%- include('_sidebar') %>
  <div class="admin-content">
    <div class="admin-head">
      <h2>Acc / Sản phẩm</h2>
      <a class="btn btn-primary" href="/admin/products/new">+ Thêm acc</a>
    </div>

    <form method="get" action="/admin/products" class="filters">
      <select name="cat" onchange="this.form.submit()">
        <option value="">Tất cả danh mục</option>
        <% categories.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= String(cat) === String(c.id) ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
      <input type="text" name="q" placeholder="Tìm acc..." value="<%= q %>" />
      <button class="btn" type="submit">Tìm</button>
    </form>

    <table class="table">
      <thead><tr><th>ID</th><th>Tiêu đề</th><th>Danh mục</th><th>Giá</th><th>Kho</th><th>Trạng thái</th><th></th></tr></thead>
      <tbody>
        <% products.forEach(function(p) { %>
          <tr>
            <td><%= p.id %></td>
            <td><%= p.title %></td>
            <td class="muted small"><%= p.category_name %></td>
            <td><%= formatVnd(p.price) %></td>
            <td><%= p.stock %></td>
            <td><span class="status status-<%= p.status %>"><%= p.status %></span></td>
            <td class="actions-cell">
              <a class="btn btn-sm" href="/admin/products/<%= p.id %>/edit">Sửa</a>
              <form method="post" action="/admin/products/<%= p.id %>/delete" onsubmit="return confirm('Xoá acc này?')" style="display:inline">
                <button class="btn btn-danger btn-sm" type="submit">Xoá</button>
              </form>
            </td>
          </tr>
        <% }); %>
        <% if (products.length === 0) { %>
          <tr><td colspan="7" class="muted">Chưa có acc nào.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('../partials/footer') %>
